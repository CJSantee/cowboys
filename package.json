{
  "name": "cowboy-counter",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "postinstall": "flowbite-react patch",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply cowboy-counter --local",
    "db:migrate:remote": "wrangler d1 migrations apply cowboy-counter --remote",
    "parity": "tsx scripts/parity.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.2",
    "@tailwindcss/vite": "^4.1.4",
    "@tanstack/react-query": "^5.74.4",
    "apexcharts": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "flowbite-react": "^0.11.7",
    "hono": "^4.13.19",
    "react": "^19.2.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.5.1",
    "react-simple-maps": "^3.0.0",
    "react-swipeable": "^7.0.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  }
}
